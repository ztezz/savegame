{
  "name": "cloudsave-hub-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "tsx watch server.ts",
    "backend:3003": "cross-env API_PORT=3003 tsx watch server.ts",
    "build": "npm --prefix frontend run build",
    "backend:build": "tsc --outDir dist",
    "backend:test": "tsx --test config/*.test.ts utils/*.test.ts",
    "start": "node dist/server.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "db:migrate:postgres": "tsx scripts/migrate-postgres-to-sqlite.ts",
    "db:verify": "tsx scripts/verify-sqlite.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^7.0.3",
    "pg": "^8.22.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
