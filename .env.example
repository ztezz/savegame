# ----- CẤU HÌNH BẢO MẬT -----
# JWT_SECRET: Dùng để mã hoá token đăng nhập (Đổi thành chuỗi bất kỳ, càng dài càng tốt)
JWT_SECRET="YOUR_SUPER_SECRET_KEY"

# ----- CẤU HÌNH DATABASE (SQLITE) -----
# Mặc định: data/savegame.sqlite, tính từ thư mục chạy backend
# DATABASE_PATH="data/savegame.sqlite"

# Chỉ dùng khi chạy npm run db:migrate:postgres
# SOURCE_DATABASE_URL="postgresql://user:password@host:5432/database"
# SOURCE_DB_SSL=true

# Port cho API server (mặc định: 3001 khi dev, 3000 khi production)
# API_PORT=3001

# Dung lượng Drive tối đa cho mỗi user, đơn vị MB (mặc định: 2048)
# DRIVE_QUOTA_MB=2048

# Origin của frontend (để giới hạn CORS). Nhiều domain cách nhau bằng dấu phẩy.
FRONTEND_ORIGIN=https://luugame.fun,https://www.luugame.fun,https://luugame.thuonghongthai97.workers.dev
