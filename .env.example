# =============================================================================
# BACKEND - chỉ được đọc bởi Node.js, không công khai ra trình duyệt
# =============================================================================

NODE_ENV=production

# Production dùng PORT; development dùng API_PORT.
PORT=3000
API_PORT=3001

# Bắt buộc dùng chuỗi ngẫu nhiên riêng, tối thiểu 32 ký tự trong production.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Các website được phép gọi API. Phân tách nhiều origin bằng dấu phẩy.
FRONTEND_ORIGIN=https://luugame.fun,https://www.luugame.fun,https://luugame.thuonghongthai97.workers.dev
FRONTEND_APP_URL=https://luugame.fun

# SQLite và thư mục lưu file trên backend.
DATABASE_PATH=data/savegame.sqlite
SQLITE_SCAN_PATHS=data,storage,/var/lib/cloudsave
UPLOADS_DIR=/data/uploads

# Giới hạn file và dung lượng Drive, đơn vị MB.
MAX_FILE_SIZE_MB=2048
DRIVE_QUOTA_MB=20480

# Chỉ cần khi chạy migrate từ PostgreSQL sang SQLite.
# SOURCE_DATABASE_URL=postgresql://user:password@host:5432/database
# SOURCE_DB_SSL=true

# =============================================================================
# FRONTEND - biến VITE_* được nhúng công khai vào JavaScript khi build
# =============================================================================

# Dùng cùng origin frontend; Worker sẽ proxy /api sang api.luugame.fun.
# Cách này loại bỏ CORS preflight trong trình duyệt.
VITE_API_URL=https://luugame.fun

# Upload cũng đi qua Worker cùng origin.
VITE_UPLOAD_URL=https://luugame.fun

# =============================================================================
# GHI CHÚ TRIỂN KHAI
# =============================================================================

# Dùng duy nhất file .env tại thư mục gốc cho cả backend và frontend.
# Backend đọc file này bằng dotenv. Vite được cấu hình đọc cùng file từ root.
# Sau khi đổi biến VITE_*, phải build lại frontend.
# Sau khi đổi biến backend, phải restart backend.
