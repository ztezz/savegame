# ----- CẤU HÌNH BẢO MẬT -----
# JWT_SECRET: Dùng để mã hoá token đăng nhập (Đổi thành chuỗi bất kỳ, càng dài càng tốt)
JWT_SECRET="YOUR_SUPER_SECRET_KEY"

# ----- CẤU HÌNH DATABASE (POSTGRESQL) -----
# Cách 1: Sử dụng Connection String (Khuyên dùng cho Supabase, Neon...)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Cách 2: Sử dụng cấu hình chi tiết từng phần
# DB_HOST="your-db-host"
# DB_PORT="5432"
# DB_USER="your-db-user"
# DB_PASSWORD="your-db-password"
# DB_NAME="your-db-name"

# Port cho API server (mặc định: 3001 khi dev, 3000 khi production)
# API_PORT=3001

# Origin của frontend (để giới hạn CORS). Nhiều domain cách nhau bằng dấu phẩy.
FRONTEND_ORIGIN=https://luugame.fun,https://www.luugame.fun,https://luugame.thuonghongthai97.workers.dev

# Supabase client
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
