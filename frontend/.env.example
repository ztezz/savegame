# GEMINI_API_KEY: Required for Gemini AI features.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# URL của backend API.
# - Khi dev (npm run dev): Vite dùng giá trị này để proxy /api sang backend.
#   Mặc định: https://api.luugame.fun
# - Khi build (npm run build): axios sẽ gọi thẳng tới URL này.
#   Ví dụ: https://api.luugame.fun
VITE_API_URL=https://api.luugame.fun
VITE_API_URL=https://api.luugame.fun

# Optional: use a DNS-only subdomain pointing directly to the backend for uploads.
# This avoids Cloudflare request buffering while normal API traffic remains proxied.
# VITE_UPLOAD_URL=https://upload.luugame.fun
